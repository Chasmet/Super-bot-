<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08111F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/buttonBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="36sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Réglages"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#0E1D32"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="Logo Super Bot"
                android:src="@drawable/logo_super_bot" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUPER BOT"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Crée • planifie • publie • automatise"
                    android:textColor="#6EDCFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="AUTOMATISATION"
            android:textColor="#6F87AA"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/rowAutomation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#102039"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙  Automatisation Android"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/textAutomationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Service Super Bot : vérification…"
                android:textColor="#FFB84D"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#102039"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:id="@+id/textBotMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Super Bot : réveillé"
                android:textColor="#59E391"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Déconnecté = le bot dort : aucune ouverture de réseau social et aucune action automatique."
                android:textColor="#A9B9D2"
                android:textSize="13sp" />
            <Button
                android:id="@+id/buttonBotPower"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="DÉCONNECTER SUPER BOT" />
        </LinearLayout>

        <TextView
            android:id="@+id/rowAccounts"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginTop="8dp"
            android:background="#102039"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:text="👤  Comptes sociaux\n     Utilise les comptes déjà ouverts dans TikTok, Instagram et YouTube"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="CONNEXION MCP"
            android:textColor="#6F87AA"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#102039"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MCP Super Bot"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Connexion directe au serveur Render de Super Bot."
                android:textColor="#A9B9D2"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/textMcpUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="URL Render : https://asset-chk-mcp.onrender.com/superbot/mcp"
                android:textColor="#63E6FF"
                android:textIsSelectable="true"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/textMcpStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="MCP : vérification…"
                android:textColor="#FFB84D"
                android:textSize="13sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/buttonMcpConnect"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Connecter Render" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <Button
                    android:id="@+id/buttonMcpTest"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Tester état" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="MISES À JOUR"
            android:textColor="#6F87AA"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#102039"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mise à jour directe depuis GitHub Releases"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/textCurrentVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Version installée : …"
                android:textColor="#A9B9D2"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/textLatestVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Dernière version : vérification nécessaire"
                android:textColor="#63E6FF"
                android:textSize="14sp" />
            <ProgressBar
                android:id="@+id/updateProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="14dp"
                android:max="100"
                android:progress="0" />
            <Button
                android:id="@+id/buttonCheckUpdate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="Rechercher et installer une mise à jour" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="LOG DES MISES À JOUR"
            android:textColor="#6F87AA"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#102039"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version 1.3.16 • connexion MCP Render"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="• URL Render visible dans les réglages\n• Bouton Connecter Render actif\n• État MCP réel affiché\n• Heartbeat automatique vers Render\n• Reconnexion automatique après ouverture ou redémarrage"
                android:textColor="#B8C6DA"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="30dp"
            android:background="#102039"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version 1.3.3 • mode veille"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="• Bouton Connecter / Déconnecter Super Bot\n• En mode déconnecté, aucun réseau social ne s'ouvre\n• Toute automatisation active est arrêtée immédiatement\n• Les tâches restent sauvegardées"
                android:textColor="#B8C6DA"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="30dp"
            android:background="#102039"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version 1.1.0 • moteur local"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="• Import vidéo Android\n• Aperçu vidéo\n• Découpe MP4 15/30/60/90 s et durée personnalisée\n• Rognage manuel début/fin\n• Bibliothèque locale et partage\n• Programmation TikTok, Instagram, YouTube Shorts et YouTube classique\n• File d'attente persistante\n• Restauration après redémarrage ou mise à jour\n• Moteur AccessibilityService pour piloter les réseaux\n• Mise à jour intégrée depuis GitHub Releases"
                android:textColor="#B8C6DA"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
